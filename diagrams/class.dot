digraph C {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.35, ranksep=0.5];
node [shape=record, style="filled", fontname="Times New Roman", fontsize=10, color="#2F5597", fillcolor="#F7FBFF"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
c [label="{BonusCalculator|+ BASE_KPI_BOUNDARY = 80 double\l+ KPI_MODIFIER_PERCENT = 25 double\l+ KPI_BOUNDARY = 100 double\l|+ calculate(EmployeePerformance) double\l- validate(EmployeePerformance) void\l}"];
p [label="{«record» EmployeePerformance|- salary double\l- kpiPercent double\l- rating int\l- years int\l|+ salary(), kpiPercent(), rating(), years()\l}"];
t [label="{BonusCalculatorTest|- calculator BonusCalculator\l|+ negativeSalaryMustBeRejected()\l+ negativeKpiMustBeRejected()\l+ ratingOutOfRangeMustBeRejected(int)\l+ negativeYearsMustBeRejected()\l+ kpiJustBelowBoundaryGivesBaseRate()\l+ boundaryAtHundredPercent()\l+ eightyPercentIsBaseRateInVariant()\l+ typicalBonus()\l+ allAdditionsTogether()\l+ yearsBoundaryFiveAndSix()\l+ zeroValuesAreAllowed()\l+ ratingFiveAddsFivePercent()\l+ bonusTable(double, int, int, double)\l}"];
c -> p [label="uses",style=dashed,arrowhead=open];
t -> c [label="tests",style=dashed,arrowhead=open];
}
