digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Прочитать правило и существующий код BonusCalculator"];
n2 [label="A1 Выделить граничные случаи: KPI 99.99 и 100.00 (вариант),\nстаж 5 и 6 лет, оклад 0, KPI 0, рейтинг 1 и 5,\nотрицательные оклад, KPI, стаж и рейтинг 0, 6"];
n3 [label="Написать тест (Arrange, Act, Assert)"];
n4 [label="Тест падает ожидаемо" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n5 [label="Исправить минимальный участок реализации:\nvalidate() вместо return 0, >= вместо >"];
n6 [label="Запустить весь набор тестов mvn test"];
n7 [label="Все тесты зеленые" ,shape=diamond,fillcolor="#FFF2CC",color="#BF9000"];
n8 [label="Добавить следующий случай"];
start -> n1;
n1 -> n2;
n2 -> n3;
n3 -> n4;
n4 -> n5 [label="да"];
n4 -> n3 [label="нет"];
n5 -> n6;
n6 -> n7;
n7 -> end [label="да"];
n7 -> n8 [label="нет"];
n8 -> n3;
}
